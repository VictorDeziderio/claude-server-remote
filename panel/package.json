{
  "name": "claude-remote-panel",
  "private": true,
  "version": "2.0.0",
  "description": "Claude Remote — painel do dev-box (React + Tailwind + xterm.js, servido pelo server.js com terminal via WebSocket/PTY)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.js",
    "check": "node --check server.js && node -e \"require('./server/config.js')\""
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "autoprefixer": "^10.4.20",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
