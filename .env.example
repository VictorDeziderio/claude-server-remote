# =============================================================================
# Claude Remote — container settings. Use with docker compose (env_file) or docker run --env-file.
# Every variable has a default in the Dockerfile; the values below ARE the defaults (edit freely).
# =============================================================================

# Default project name (created in PROJECTS_DIR if the container starts with no project).
PROJECT_FOLDER=claude
# Multi-tmux: each project has its own "claude-<name>" session and its own remote-control.
# EMPTY (recommended) -> remote-control uses the PROJECT NAME (e.g. /remote-control pilot).
# Set a value only to FORCE one fixed name for every project.
REMOTE_CONTROL_NAME=
# Seconds to wait (for Claude to load) before sending remote-control.
# Note: remote-control is turned on/off PER PROJECT (panel -> panel.json: autoRemote, applies at once).
CLAUDE_AUTOCMD_DELAY=15

# GitHub: token (repo scope) for the automatic gh login and the backup pushes. Empty = manual login.
GH_TOKEN=
# Identity of the backup commits.
GIT_AUTHOR_NAME=claude-devbox
GIT_AUTHOR_EMAIL=devbox@localhost

# Automatic project backup (commit + push of each git repo).
BACKUP_ENABLED=true
BACKUP_INTERVAL=3600
# Config snapshot (~/.claude + ~/.claude.json) in /root/.claude-backups (keeps 7). Download it in the panel → Backup.
CONFIG_BACKUP_INTERVAL=86400
# Optional: incremental copy of the whole volume (/root) to ANOTHER disk or mount (bind a host
# folder here). Unchanged files are hard links to the previous copy, so each copy only takes the
# space of what changed. Skips node_modules, caches and agent work copies.
# VOLUME_BACKUP_DIR=/backup
# VOLUME_BACKUP_INTERVAL=86400
# VOLUME_BACKUP_KEEP=7
# VOLUME_BACKUP_EXCLUDE=projects/big-data/,*.iso

# Backoff of the supervisor (claude-loop.sh) and of the panel (start.sh#run_bg): without it, a process
# that crashes fast (bug/OOM) would reopen every few seconds forever and overload the machine.
# Rarely needs changing — the defaults treat short sessions as normal use, not a crash loop.
# Seconds running to count as "healthy" and reset the failure counter.
MIN_HEALTHY_RUN_S=20
# Ceiling of the exponential backoff between restarts (seconds): 3,6,12,24,48,60,60...
MAX_BACKOFF_S=60
# Fast failures in a row before the Claude supervisor stops reopening it and drops
# to a plain shell (see Dashboard/Logs → Sessions).
MAX_FAST_FAILS=6

# Panel: single-port gateway.
PANEL_ENABLED=true
# PUBLIC port of the gateway — point your domain / reverse proxy to it.
GATEWAY_PORT=8080
# Optional: a public domain for automatic HTTPS (Caddy + Let's Encrypt; publish ports 80 and 443).
# PANEL_DOMAIN=panel.example.com
# Optional: your reverse proxy IPs/CIDRs, so the real client IP is used (rate limit, audit log).
# TRUSTED_PROXIES=10.0.0.0/8
# Folder that holds the project folders.
PROJECTS_DIR=/root/projects

# --- AUTH ---
# Panel ( / ): login + password (the panel's own login page).
# REQUIRED. Left empty here on purpose: without it (or with the old public default)
# the panel REFUSES to start — it exposes a shell. Never commit a value.
PANEL_LOGIN=admin
PANEL_PASSWORD=
# Panel session lifetime (days), renewed while the device uses the panel (a device used at least
# once in this period never signs in again). Changing PANEL_PASSWORD signs out every session.
PANEL_SESSION_DAYS=365

# --- USAGE LIMITS (panel: widget on the projects page + card in Account) ---
# The Claude plan (Pro/Max: 5-hour + weekly windows) is read automatically from the server's login.
# Anthropic API spend: only with an Admin API key (sk-ant-admin...). There is no balance endpoint:
# the panel shows today's / this month's spend (Admin API cost report). Prefer keeping the key
# in the secrets file on the volume (same as PANEL_PASSWORD) instead of the environment.
ANTHROPIC_ADMIN_KEY=
# Monthly API budget (USD) -> % + alerts. Empty = no budget.
ANTHROPIC_API_BUDGET_USD=
# Check interval (seconds, minimum 60) and alert thresholds (%).
USAGE_POLL_INTERVAL=300
USAGE_THRESHOLDS=80,95

# Auto-resume: when a project hits the plan usage limit, the panel types this text in its
# session once the limit resets (only if nobody typed since and the screen is idle).
# Also a switch in Settings. AUTO_RESUME=0 turns it off for everyone.
# AUTO_RESUME=1
# AUTO_RESUME_TEXT=continue
# AUTO_RESUME_MARGIN_SECONDS=90
# After a restart (deploy, container restart), projects that were in the middle of a task get
# the same text once the screen is idle (only if they reopen the same conversation).
# AUTO_RESUME_RESTART_SECONDS=45

# Optional: your hosting's deploy hook URL (a secret). Shows Settings → "Update the panel", with
# "Update when idle": it waits until no project is in the middle of a task, then calls the hook.
# Name of this server on the remote hub (/remote?key=...). Default: the container hostname.
# HUB_NAME=my-server
# Biggest backup (.tgz) accepted by Backup -> Import / restore, in MB.
# RESTORE_MAX_MB=4096

# DEPLOY_WEBHOOK_URL=
# Claude Code automatic update (also a switch in Settings): checks npm every CLAUDE_UPDATE_HOURS
# and installs a newer version (rolls back if it does not run). 0 turns it off for everyone.
# CLAUDE_AUTO_UPDATE=1
# CLAUDE_UPDATE_HOURS=6
# 0 turns the usage monitor off.
USAGE_MONITOR=1
