# =============================================================================
# Claude Remote — variáveis do dev-box. Use com docker compose (env_file) ou docker run --env-file.
# Todas têm default no Dockerfile; os valores abaixo SÃO os defaults (edite à vontade).
# =============================================================================

# Nome do projeto default (criado em PROJECTS_DIR se o container subir sem nenhum projeto).
PROJECT_FOLDER=claude
# Multi-tmux: cada projeto tem sua sessão "claude-<nome>" e seu remote-control.
# VAZIO (recomendado) -> o remote usa o NOME DO PROJETO (ex.: /remote-control pilot).
# Defina um valor só para FORÇAR um nome fixo p/ todos os projetos.
REMOTE_CONTROL_NAME=
# Segundos de espera (Claude carregar) antes de enviar o remote-control.
# Obs.: ligar/desligar o remote é POR PROJETO (painel -> panel.json: autoRemote, toggle imediato).
CLAUDE_AUTOCMD_DELAY=15

# GitHub: token (escopo repo) p/ auto-login do gh e push do backup. Vazio = login manual.
GH_TOKEN=
# Identidade dos commits do backup.
GIT_AUTHOR_NAME=claude-devbox
GIT_AUTHOR_EMAIL=devbox@localhost

# Backup automático dos projetos (commit+push de cada repo git).
BACKUP_ENABLED=true
BACKUP_INTERVAL=3600
# Snapshot da config (~/.claude + ~/.claude.json) em /root/.claude-backups (mantém 7). Baixe pelo painel → Backup.
CONFIG_BACKUP_INTERVAL=86400

# Backoff do supervisor (claude-loop.sh) e do painel (start.sh#run_bg): sem isso, um processo
# que crasha rápido (bug/OOM) reabriria a cada poucos segundos pra sempre e sobrecarregaria a
# VM sozinho. Raramente precisa mudar — defaults calibrados para sessões curtas serem uso
# normal, não crash-loop.
# Segundos rodando para contar como "saudável" e zerar o contador de falhas.
MIN_HEALTHY_RUN_S=20
# Teto do backoff exponencial entre reaberturas (segundos): 3,6,12,24,48,60,60...
MAX_BACKOFF_S=60
# Falhas rápidas seguidas até o supervisor do Claude desistir de reabrir sozinho e cair
# num shell livre (ver Dashboard/Logs → Sessões).
MAX_FAST_FAILS=6

# Painel: gateway de uma porta só.
PANEL_ENABLED=true
# Porta PÚBLICA do gateway — aponte o seu domínio / proxy reverso para ela.
GATEWAY_PORT=8080
# Diretório com as pastas de projeto.
PROJECTS_DIR=/root/projects

# --- AUTH ---
# Painel ( / ): login + senha (página de login própria do painel).
# OBRIGATÓRIA. Fica vazia aqui de propósito: sem ela (ou com o antigo default público)
# o painel RECUSA subir — ele expõe um shell. Nunca versione um valor.
PANEL_LOGIN=admin
PANEL_PASSWORD=
# Validade da sessão do painel (dias). Trocar a PANEL_PASSWORD invalida todas as sessões.
PANEL_SESSION_DAYS=30

# --- LIMITES DE USO (painel: widget na página de projetos + card em Conta) ---
# O plano do Claude (Pro/Max: janela de 5h + semanal) é lido sozinho do login do servidor.
# Gasto da API Anthropic: só com uma Admin API key (sk-ant-admin...). Não existe endpoint de
# saldo: o painel mostra o gasto de hoje / do mês (Admin API cost report). Prefira guardar a
# chave no arquivo de segredos do volume (mesmo do PANEL_PASSWORD) em vez do Environment.
ANTHROPIC_ADMIN_KEY=
# Orçamento mensal da API (US$) -> % + alertas. Vazio = sem orçamento.
ANTHROPIC_API_BUDGET_USD=
# Intervalo da checagem (segundos, mínimo 60) e limiares de alerta (%).
USAGE_POLL_INTERVAL=300
USAGE_THRESHOLDS=80,95

# Auto-resume: when a project hits the plan usage limit, the panel types this text in its
# session once the limit resets (only if nobody typed since and the screen is idle).
# Also a switch in Settings. AUTO_RESUME=0 turns it off for everyone.
# AUTO_RESUME=1
# AUTO_RESUME_TEXT=continue
# AUTO_RESUME_MARGIN_SECONDS=90
# 0 desliga o monitor de uso.
USAGE_MONITOR=1
