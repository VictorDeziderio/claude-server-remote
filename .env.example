# Variáveis do dev-box "claude" — cole no campo Environment do serviço no EasyPanel.
# Todas têm default no Dockerfile; aqui ficam para referência/edição.

############
# IDE web (code-server)
############
# Liga/desliga o IDE web (VS Code no navegador)
IDE_ENABLED=true
# (LEGADO/fallback) Usado como valor padrão de PANEL_PASSWORD e IDE_TOKEN quando esses
# estiverem vazios. Prefira definir PANEL_PASSWORD e IDE_TOKEN diretamente (mais abaixo).
IDE_PASSWORD=senha-antiga-removida

# IP allowlist (item 1): NÃO é configurado aqui — o filtro de IP precisa ser feito no
# proxy do EasyPanel (aba Segurança do serviço), porque o container só enxerga o IP do
# proxy interno (o IP real do cliente chega via header X-Forwarded-For). Hoje: 0.0.0.0/0
# (aberto a todos). Para restringir, adicione os CIDRs permitidos na aba Segurança.

############
# Auto-start do Claude (ao reiniciar)
############
# Respawn automático (sem variável — comportamento fixo do start.sh): o Claude roda em loop
# (reabre no exit/crash em ~3s) e um watchdog recria a sessão tmux se ela cair (~10s).
# Para cair no shell de propósito: dê `exit` e aperte Ctrl+C na janela de 3s.
#
# Pasta (dentro de /root) onde o Claude inicia. Criada automaticamente se não existir.
PROJECT_FOLDER=projects
# Nome anexado ao comando automático -> ex.: "/remote-control meu-servidor"
REMOTE_CONTROL_NAME=meu-servidor
# Comando enviado ao Claude no start (deixe vazio "" para desativar).
# Só dispara se o /login do Claude estiver feito E o Claude estiver ativo na sessão.
# O nome do remote-control vem de REMOTE_CONTROL_NAME — NÃO embuta o nome aqui.
CLAUDE_AUTOCMD=/remote-control
# Segundos de espera (Claude carregar) antes de enviar o comando.
CLAUDE_AUTOCMD_DELAY=15

############
# GitHub (gh) — auto-login (item 7)
############
# Token com escopo "repo" (Personal Access Token). Com ele, o gh autentica sozinho no
# start e o git passa a fazer push sem login manual (usado pelo backup automático).
# Deixe vazio para fazer o login manual via `gh auth login`.
GH_TOKEN=
# Identidade dos commits (opcional; default: claude-devbox / devbox@easypanel.local)
GIT_AUTHOR_NAME=claude-devbox
GIT_AUTHOR_EMAIL=devbox@easypanel.local

############
# Backup automático dos projetos (item 6)
############
# Liga/desliga o backup periódico (commit+push de cada repo git dentro de PROJECT_FOLDER).
BACKUP_ENABLED=true
# Intervalo entre backups, em segundos (3600 = 1h).
BACKUP_INTERVAL=3600
# Requisitos: cada projeto deve ser um repo git com remote 'origin' configurado, e GH_TOKEN
# (ou login do gh) válido para o push. Log: /root/.claude/logs/backup.log

############
# Painel + IDE: gateway de uma porta só (credenciais SEPARADAS)
############
# Liga/desliga o painel.
PANEL_ENABLED=true
# Porta PÚBLICA do gateway — aponte o domínio do EasyPanel para ela (ex.: 8080 ou 7000).
GATEWAY_PORT=8080
#
# --- PAINEL ( / ): protegido por LOGIN + SENHA (basic_auth do gateway) ---
# Usuário e senha de acesso ao PAINEL de controle. TROQUE por uma senha forte.
PANEL_LOGIN=admin
PANEL_PASSWORD=
#
# --- IDE ( /ide ): protegido por TOKEN (senha nativa do code-server) ---
# Quem tem o TOKEN entra no /ide sem precisar do login do painel (link compartilhável).
# É a barreira pública para um Claude com permissão total — use um token longo e forte.
IDE_TOKEN=
#
# Diretório que contém as pastas de projeto (cada projeto = uma subpasta).
PROJECTS_DIR=/root/projects
# Acesso:  Painel -> https://<domínio>/  (LOGIN+SENHA)   IDE -> https://<domínio>/ide  (TOKEN)
#   EasyPanel: aponte o domínio do serviço para a GATEWAY_PORT.
# (opcional) IDE num domínio próprio: preencha IDE_PUBLIC_URL com a URL pública do IDE.
IDE_PUBLIC_URL=

############
# Config por projeto (panel.json) — NÃO vai aqui no Environment
############
# As opções por projeto (autoStartClaude / autoRemote) ficam em /root/.claude/panel.json
# e são editadas pelo PAINEL (chips "🤖 Claude" e "📡 Remote" em cada projeto). A semente
# inicial vem de claude/panel.json (imagem). 'defaults' vale p/ projeto sem entrada própria.
