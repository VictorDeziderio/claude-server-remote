# =============================================================================
# Claude Remote — variáveis do dev-box. Cole no campo Environment do EasyPanel.
# Todas têm default no Dockerfile; os valores abaixo SÃO os defaults (edite à vontade).
# =============================================================================

# IDE web (code-server) — true/false
IDE_ENABLED=true

# Pasta (dentro de /root) onde o Claude inicia. Criada automaticamente.
PROJECT_FOLDER=projects
# Nome anexado ao comando do remote-control -> "/remote-control <nome>".
REMOTE_CONTROL_NAME=meu-servidor
# Segundos de espera (Claude carregar) antes de enviar o remote-control.
# Obs.: ligar/desligar o remote é POR PROJETO (painel -> panel.json: autoRemote).
CLAUDE_AUTOCMD_DELAY=15

# GitHub: token (escopo repo) p/ auto-login do gh e push do backup. Vazio = login manual.
GH_TOKEN=
# Identidade dos commits do backup.
GIT_AUTHOR_NAME=claude-devbox
GIT_AUTHOR_EMAIL=devbox@easypanel.local

# Backup automático dos projetos (commit+push de cada repo git).
BACKUP_ENABLED=true
BACKUP_INTERVAL=3600

# Painel + IDE: gateway de uma porta só.
PANEL_ENABLED=true
# Porta PÚBLICA do gateway — aponte o domínio do EasyPanel para ela.
GATEWAY_PORT=8080
# Diretório com as pastas de projeto.
PROJECTS_DIR=/root/projects

# --- AUTH (TROQUE por valores fortes e DIFERENTES entre si) ---
# O boot avisa no log se ficarem no default/vazios ou iguais entre si.
# Painel ( / ): login + senha (página de login própria do painel).
PANEL_LOGIN=admin
PANEL_PASSWORD=senha-antiga-removida
# IDE ( /ide ): token (senha nativa do code-server, link compartilhável). USE OUTRO valor.
IDE_TOKEN=senha-antiga-removida
